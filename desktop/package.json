{
  "name": "xiuxian-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "修仙助手桌面应用",
  "author": "Liang5757",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node ../scripts/dev.mjs",
    "dev:renderer": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build:renderer": "npm run typecheck && vite build",
    "build": "npm run build:renderer && electron-builder --win portable",
    "start": "electron ."
  },
  "build": {
    "appId": "com.liang.xiuxian",
    "productName": "修仙助手",
    "directories": {
      "output": "../release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/app.png",
      "assets/app.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../xiuxian-rs/target/release/xiuxian.exe",
        "to": "engine.exe"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "assets/app.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "portable": {
      "artifactName": "修仙助手.exe",
      "requestExecutionLevel": "admin"
    },
    "electronDist": "../node_modules/electron/dist"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "sass": "^1.108.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
